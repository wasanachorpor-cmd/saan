# Copy to .env and change the secret before sharing a server.
SAAN_SECRET_KEY=replace-with-a-long-random-string
SAAN_DATABASE_URL=sqlite:///./data/saan.db
SAAN_UPLOAD_DIR=./data/uploads
SAAN_SEED_DEMO=false

# Required for reading a page. The photo is sent to Google Gemini.
# Keep the key only in this file. Do not paste it into chat.
SAAN_GEMINI_API_KEY=
SAAN_GEMINI_MODEL=gemini-3.8-flash
SAAN_SESSION_HTTPS_ONLY=false
SAAN_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional social login. Leave blank to keep email sign-in only.
# Redirect URLs to register with each provider:
#   http://127.0.0.1:8000/auth/line/callback
#   http://127.0.0.1:8000/auth/facebook/callback
SAAN_LINE_CHANNEL_ID=
SAAN_LINE_CHANNEL_SECRET=
SAAN_FACEBOOK_APP_ID=
SAAN_FACEBOOK_APP_SECRET=
